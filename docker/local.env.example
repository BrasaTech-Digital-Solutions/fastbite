# Settings for `docker compose up`. Copy this file to .env in the repository root (it is git-ignored)
# and fill in only what you need: everything works without it.

# Shown by both environments and written into promotion bundles
FASTBITE_VERSION=local

# Ports on this machine
FASTBITE_PROXY_PORT=8088
FASTBITE_PRODUCTION_PORT=8090
FASTBITE_SANDBOX_PORT=8091
FASTBITE_DB_PORT=5434
FASTBITE_MAIL_UI_PORT=8027

# Stripe test mode keys, used by both environments locally
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECTED_ACCOUNT=

# VERI*FACTU in the sandbox: put the certificate in docker/secrets/ (see the README there)
SANDBOX_VERIFACTU_CERTIFICATE_PATH=
VERIFACTU_CERTIFICATE_PASSWORD=
VERIFACTU_ISSUERS=
